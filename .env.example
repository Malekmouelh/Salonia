# Base MongoDB
# - Atlas (équipe) : mongodb+srv://UTILISATEUR:MOT_DE_PASSE@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
# - Local (npm run db:local) : mongodb://127.0.0.1:27017
MONGODB_URI="mongodb://127.0.0.1:27017"
# Nom de la base (chaque membre peut utiliser la sienne : salonia_malek, salonia_maya…)
MONGODB_DB="salonia"

# Clé secrète NextAuth pour signer les sessions (générer : npx auth secret, ou openssl rand -base64 32)
# AUTH_SECRET est le nom standard de NextAuth ; SESSION_SECRET reste accepté pour les anciens .env.
AUTH_SECRET="change-moi"

# Mode démonstration : comptes de démo sur /login et lien de réinitialisation affiché à l'écran
DEMO_MODE="true"

# Clé API Anthropic pour les fonctions IA (sans clé : modes hors ligne)
ANTHROPIC_API_KEY=""

# IA du catalogue (Module 2) : clé Google Gemini gratuite (https://aistudio.google.com/apikey).
# Prioritaire sur Anthropic pour le catalogue ; vide : Anthropic, sinon mode hors ligne.
GEMINI_API_KEY=""
# Facultatif : modèle Gemini (défaut gemini-3.1-flash-lite, doté d'une offre gratuite)
GEMINI_MODEL=""

# Secret du déclenchement automatique des rappels (/api/cron/reminders)
CRON_SECRET="change-moi"

# SalonEscrow (acompte bloqué sur la chaîne, jeton de test MockTND). Vide : fonctionnalité désactivée.
# TESTNET UNIQUEMENT : ces clés ne doivent jamais détenir de vrais fonds. Lues par le serveur seulement.
# Réseau : "hardhat" (nœud local `npx hardhat node`, http://127.0.0.1:8545) ou "sepolia".
ESCROW_NETWORK=""
ESCROW_RPC_URL=""
# Adresses du fichier de déploiement du dépôt SalonEscrow (BookingEscrow et MockTND).
ESCROW_CONTRACT_ADDRESS=""
ESCROW_TOKEN_ADDRESS=""
# Administrateur du contrat (propriétaire) : configure les centres et le staff, et paie le gaz de test des wallets.
ESCROW_ADMIN_PRIVATE_KEY=""
# Phrase HD (12 mots) dont le serveur dérive un wallet par compte Salonia et par trésorerie de centre.
# Seul l'index de dérivation est enregistré en base. Générer une phrase NEUVE, réservée à ce projet.
ESCROW_HD_MNEMONIC=""
