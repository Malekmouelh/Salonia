# Base de données PostgreSQL (local : "npx prisma dev", ou URL Neon/Supabase)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Clé secrète pour signer les sessions (générer : openssl rand -base64 32)
SESSION_SECRET="change-moi"

# Mode démonstration : comptes de démo sur /login et lien de réinitialisation affiché à l'écran
DEMO_MODE="true"

# Clé API Anthropic pour l'assistant IA (sans clé : mode hors ligne par mots-clés)
ANTHROPIC_API_KEY=""
