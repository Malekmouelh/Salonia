# Base MongoDB
# - Atlas (équipe) : mongodb+srv://UTILISATEUR:MOT_DE_PASSE@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
# - Local (npm run db:local) : mongodb://127.0.0.1:27017
MONGODB_URI="mongodb://127.0.0.1:27017"
# Nom de la base (chaque membre peut utiliser la sienne : salonia_malek, salonia_maya…)
MONGODB_DB="salonia"

# Clé secrète NextAuth pour signer les sessions (générer : npx auth secret, ou openssl rand -base64 32)
# AUTH_SECRET est le nom standard de NextAuth ; SESSION_SECRET reste accepté pour les anciens .env.
AUTH_SECRET="change-moi"

# Mode démonstration : comptes de démo sur /login et lien de réinitialisation affiché à l'écran
DEMO_MODE="true"

# Clé API Anthropic pour les fonctions IA (sans clé : modes hors ligne)
ANTHROPIC_API_KEY=""

# Secret du déclenchement automatique des rappels (/api/cron/reminders)
CRON_SECRET="change-moi"
